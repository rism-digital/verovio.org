<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://music-encoding.org/schema/5.1/mei-all.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="https://music-encoding.org/schema/5.1/mei-all.rng" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt>
            <title>Support for score overlapping</title>
         </titleStmt>
         <pubStmt>
            <respStmt>
               <persName role="encoder" auth.uri="https://orcid.org/0000-0003-4151-0499">David Lewis</persName>
            </respStmt>
            <date isodate="2025-04-14">14 April 2025</date>
            <pubPlace>
               <ref target="https://github.com/rism-digital/verovio/pull/" />
            </pubPlace>
         </pubStmt>
         <seriesStmt>
            <title>Verovio test suite</title>
         </seriesStmt>
         <notesStmt>
            <annot>Annotation with @type "score" and shown with ribbons should be 
               drawn so that they don't clash visually.</annot>
         </notesStmt>
      </fileDesc>
      <encodingDesc>
         <appInfo>
            <application version="5.2.0-dev-4702b5e" label="5.2">
               <name>Verovio</name>
            </application>
         </appInfo>
      </encodingDesc>
   </meiHead>
   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef n="1">
                  <staffGrp>
                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2" meter.count="4" meter.unit="4" />
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure>
                     <staff n="1">
                        <layer n="1">
                           <note xml:id="note-1" dur="4" oct="4" pname="c" />
                           <note xml:id="note-2" dur="4" oct="4" pname="c" />
                           <note xml:id="note-3" dur="4" oct="4" pname="g" />
                           <note dur="4" oct="4" pname="g" />
                        </layer>
                     </staff>
                     <annot type="score" staff="1" startid="#note-2" endid="#note-3">Middle annotation.</annot>
                     <annot type="score" staff="1" startid="#note-1" endid="#note-3">Start annotation.</annot>
                     <annot type="score" staff="1" tstamp="1.5" tstamp2="0m+4">Long annotation.</annot>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>