<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://music-encoding.org/schema/dev/mei-all.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="https://music-encoding.org/schema/dev/mei-all.rng" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="6.0-dev">
   <meiHead>
      <fileDesc>
         <titleStmt>
            <title>Support for score annotations on multiple staves</title>
         </titleStmt>
         <pubStmt>
            <respStmt>
               <persName role="encoder" auth.uri="https://orcid.org/0000-0003-4151-0499">David Lewis</persName>
            </respStmt>
            <date isodate="2025-04-14">14 April 2025</date>
            <pubPlace>
               <ref target="https://github.com/rism-digital/verovio/pull/" />
            </pubPlace>
         </pubStmt>
         <seriesStmt>
            <title>Verovio test suite</title>
         </seriesStmt>
         <notesStmt>
            <annot>Annotation with @type "score" can apply to multiple staves
               either implicitly or explicitly.</annot>
         </notesStmt>
      </fileDesc>
      <encodingDesc>
         <appInfo>
            <application version="5.2.0-dev-4702b5e" label="5.2">
               <name>Verovio</name>
            </application>
         </appInfo>
      </encodingDesc>
   </meiHead>
   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef n="1">
                  <staffGrp>
                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2" meter.count="4" meter.unit="4" />
                     <staffDef n="2" lines="5" clef.shape="F" clef.line="4" meter.count="4" meter.unit="4" />
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure>
                     <staff n="1">
                        <layer n="1">
                           <note xml:id="note-1" dur="4" oct="4" pname="c" />
                           <note xml:id="note-2" dur="4" oct="4" pname="c" />
                           <note xml:id="note-3" dur="4" oct="4" pname="g" />
                           <note dur="4" oct="4" pname="g" />
                        </layer>
                     </staff>
                     <staff n="2">
                        <layer n="1">
                           <note dur="4" oct="2" pname="c" />
                           <note dur="4" oct="3" pname="c" />
                           <note dur="4" oct="3" pname="e" />
                           <note xml:id="note-8" dur="4" oct="3" pname="c" />
                        </layer>
                     </staff>
                     <annot type="score" staff="1 2" startid="#note-1" endid="#note-2">The region between specified notes is indicated with a ribbon over 
                        the indicated staves (here the notes are in the same layer).</annot>
                     <annot type="score" startid="#note-3" endid="#note-8">The region between notes is indicated. In this case, which staves
                        are involved is not explicit, and is ambiguous from the guidelines.</annot>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>