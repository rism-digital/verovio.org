                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2" />
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure n="1">
                     <staff n="1">
                        <layer n="1">
                           <note xml:id="n1phmrc7" dur="4" oct="5" pname="f" stem.dir="down">
                              <accid accid="s" func="edit" />
