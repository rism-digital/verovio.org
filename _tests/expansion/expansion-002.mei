   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef>
                  <pgHead />
                  <staffGrp>
                     <staffGrp bar.thru="true">
                        <grpSym symbol="brace" />
                        <instrDef midi.channel="0" midi.instrnum="0" midi.volume="78%" />
                        <staffDef n="1" lines="5" ppq="1">
                           <clef shape="G" line="2" />
                           <keySig sig="3s" />
                           <meterSig count="3" unit="4" />
                        </staffDef>
                        <staffDef n="2" lines="5" ppq="1">
                           <clef shape="F" line="4" />
                           <keySig sig="3s" />
                           <meterSig count="3" unit="4" />
                        </staffDef>
                     </staffGrp>
                  </staffGrp>
               </scoreDef>
               <section>
                  <expansion xml:id="default" plist="#Upbeat #A #A1 #A #A2 #B #A #A-Fine"/>
                  <expansion xml:id="minimal" plist="#Upbeat #A #A2 #B #A #A-Fine"/>
                  <expansion xml:id="unsorted" plist="#Upbeat #B #A #A1 #A #A-Fine"/>
                  <expansion xml:id="test-no-plist"/>
                  <section xml:id="Upbeat">
                     <measure n="0">
                        <staff n="1">
                           <layer n="1">
                              <note dur="4" oct="4" pname="e" stem.dir="up" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <rest dur="4" />
                           </layer>
                        </staff>
                        <tempo place="above" staff="1" tstamp="1" midi.bpm="240" mm="80" mm.unit="2" mm.dots="1">
                           <rend glyph.auth="smufl"></rend> = 80</tempo>
                        <dir place="below" staff="1" tstamp="1" vgrp="2">
                           <rend halign="center" color="red" fontsize="larger" fontstyle="normal" fontweight="bold">Upbeat</rend>
                        </dir>
                     </measure>
                  </section>
                  <section xml:id="A">
                     <measure left="rptstart" n="1">
                        <staff n="1">
                           <layer n="1">
                              <note dur="2" oct="4" pname="a" stem.dir="up" />
                              <note dur="4" oct="4" pname="b" stem.dir="down" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <note dur="4" oct="2" pname="a" stem.dir="up" />
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                           </layer>
                        </staff>
                        <dir type="segno" place="above" staff="1" tstamp="0">
                           <rend halign="center" glyph.auth="smufl" fontstyle="normal">𝄋</rend>
                        </dir>
                        <dir place="below" staff="1" tstamp="1" vgrp="2">
                           <rend color="red" fontsize="larger" fontstyle="normal" fontweight="bold">A</rend>
                        </dir>
                     </measure>
                     <measure n="2">
                        <staff n="1">
                           <layer n="1">
                              <note dur="2" oct="5" pname="c" stem.dir="down" accid.ges="s" />
                              <note dur="4" oct="4" pname="b" stem.dir="down" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <note dur="4" oct="2" pname="e" stem.dir="up" />
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                           </layer>
                        </staff>
                     </measure>
                     <measure n="3">
                        <staff n="1">
                           <layer n="1">
                              <note dur="2" oct="4" pname="a" stem.dir="up" />
                              <note dur="4" oct="4" pname="e" stem.dir="up" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <note dur="4" oct="2" pname="a" stem.dir="up" />
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                           </layer>
                        </staff>
                     </measure>
                  </section>
                  <ending xml:id="A1" lendsym="angledown" n="1.">
                     <measure right="rptend" n="4">
                        <staff n="1">
                           <layer n="1">
                              <note dur="2" oct="3" pname="a" stem.dir="up" />
                              <note dur="4" oct="4" pname="e" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <note dur="4" oct="3" pname="c" stem.dir="up" accid.ges="s" />
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                           </layer>
                        </staff>
                        <dir place="below" staff="1" tstamp="1" vgrp="2">
                           <rend color="red" fontsize="larger" fontstyle="normal" fontweight="bold">A1</rend>
                        </dir>
                     </measure>
                  </ending>
                  <ending xml:id="A2" lendsym="none" n="2.">
                     <measure right="end" n="5">
                        <staff n="1">
                           <layer n="1">
                              <note dur="2" oct="4" pname="a" stem.dir="up" />
                              <note dur="4" oct="5" pname="c" stem.dir="down" accid.ges="s" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <note dur="4" oct="2" pname="a" stem.dir="up" />
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                           </layer>
                        </staff>
                        <dir place="below" staff="1" tstamp="1" vgrp="2">
                           <rend color="red" fontsize="larger" fontstyle="normal" fontweight="bold">A2</rend>
                        </dir>
                     </measure>
                  </ending>
                  <ending xml:id="A-Fine" lendsym="angledown" n="Fine">
                     <measure right="end" n="6">
                        <staff n="1">
                           <layer n="1">
                              <note dots="1" dur="2" oct="3" pname="a" stem.dir="up" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <chord dots="1" dur="2" stem.dir="down">
                                 <note oct="2" pname="a" />
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                           </layer>
                        </staff>
                        <dir place="below" staff="1" tstamp="1" vgrp="2">
                           <rend color="red" fontsize="larger" fontstyle="normal" fontweight="bold">A-Fine</rend>
                        </dir>
                     </measure>
                  </ending>
                  <section xml:id="B">
                     <measure n="7">
                        <staff n="1">
                           <layer n="1">
                              <note dur="2" oct="4" pname="b" stem.dir="down" />
                              <note dur="4" oct="5" pname="c" stem.dir="down" accid.ges="s" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <note dur="4" oct="2" pname="e" stem.dir="up" />
                              <chord dur="4" stem.dir="down">
                                 <note oct="2" pname="b" />
                                 <note oct="3" pname="g" accid.ges="s" />
                              </chord>
                              <chord dur="4" stem.dir="down">
                                 <note oct="2" pname="b" />
                                 <note oct="3" pname="g" accid.ges="s" />
                              </chord>
                           </layer>
                        </staff>
                        <dir place="below" staff="1" tstamp="1">
                           <rend color="red" fontsize="larger" fontstyle="normal" fontweight="bold">B</rend>
                        </dir>
                     </measure>
                     <measure n="8">
                        <staff n="1">
                           <layer n="1">
                              <note dur="2" oct="5" pname="d" stem.dir="down" />
                              <note dur="4" oct="4" pname="b" stem.dir="down" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <note dur="4" oct="2" pname="e" stem.dir="up" />
                              <chord dur="4" stem.dir="down">
                                 <note oct="2" pname="b" />
                                 <note oct="3" pname="g" accid.ges="s" />
                              </chord>
                              <chord dur="4" stem.dir="down">
                                 <note oct="2" pname="b" />
                                 <note oct="3" pname="g" accid.ges="s" />
                              </chord>
                           </layer>
                        </staff>
                     </measure>
                     <measure n="9">
                        <staff n="1">
                           <layer n="1">
                              <note dur="2" oct="5" pname="c" stem.dir="down" accid.ges="s" />
                              <note dur="4" oct="5" pname="d" stem.dir="down" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <note dur="4" oct="2" pname="a" stem.dir="up" />
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                           </layer>
                        </staff>
                     </measure>
                     <measure right="rptend" n="10">
                        <staff n="1">
                           <layer n="1">
                              <note dur="2" oct="5" pname="e" stem.dir="down" />
                              <note dur="4" oct="4" pname="e" stem.dir="up" />
                           </layer>
                        </staff>
                        <staff n="2">
                           <layer n="5">
                              <note dur="4" oct="2" pname="a" stem.dir="up" />
                              <chord dur="4" stem.dir="down">
                                 <note oct="3" pname="e" />
                                 <note oct="4" pname="c" accid.ges="s" />
                              </chord>
                              <rest dur="4" />
                           </layer>
                        </staff>
                        <dir type="dalsegno" place="above" staff="2" tstamp="4" vgrp="2020">
                           <rend halign="right">D.S. al Fine</rend>
                        </dir>
                     </measure>
                  </section>
