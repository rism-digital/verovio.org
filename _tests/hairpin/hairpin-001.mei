<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt>
            <title>Hairpin example on multiple lines</title>
         </titleStmt>
         <pubStmt>
            <date isodate="2017-05-09">2017-05-09</date>
         </pubStmt>
         <notesStmt>
            <annot>Verovio supports "hairpin" elements. As with dynamics, the placement can be specified with the "place" attribute. Hairpins
					overlapping two measures or more and interrupted by a system break or a page break are displayed appropriately.</annot>
         </notesStmt>
      </fileDesc>
      <encodingDesc>
         <appInfo>
            <application version="1.0.0" label="2">
               <name>Verovio</name>
            </application>
         </appInfo>
      </encodingDesc>
      <extMeta><![CDATA[ { "breaks": "encoded" }]]></extMeta>
   </meiHead>
   <music>
      <body>
