                  </measure>
                  <measure n="3">
                     <staff n="2">
                        <layer n="1">
                           <note xml:id="n5" dur="2" oct="4" pname="c" tstamp="1" />
                        </layer>
                        <layer n="2">
                           <note dots="1" dur="4" oct="3" pname="g" stem.dir="up" tstamp="1" />
                           <note dur="8" oct="3" pname="b" stem.dir="up" tstamp="2.5" accid="f" />
                        </layer>
                        <layer n="3">
                           <note xml:id="n6" dur="2" oct="3" pname="e" stem.dir="down" tstamp="1" />
                        </layer>
                     </staff>
                     <slur staff="2" startid="#n6" endid="#n8" curvedir="below" />
                     <tie vo="4.2vu" endho="2vu" staff="2" startid="#n5" endid="#n7" />
                  </measure>
